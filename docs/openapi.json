  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Progress": {
        "properties": {
          "answers": {
            "additionalProperties": true,
            "type": "object",
            "title": "Answers"
          },
          "revision": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answers",
          "revision"
        ],
        "title": "Progress"
      },
      "Registration": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "student_id": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Student Id"
          },
          "consent_core": {
            "type": "boolean",
            "title": "Consent Core"
          },
          "privacy_version": {
            "type": "string",
            "title": "Privacy Version"
          },
          "enrollment_code": {
            "type": "string",
            "maxLength": 200,
            "title": "Enrollment Code",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "student_id",
          "consent_core",
          "privacy_version"
        ],
        "title": "Registration"
      },
      "Review": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role"
          },
          "scores": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Scores"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "scores"
        ],
        "title": "Review"
      },
      "Submission": {
        "properties": {
          "answers": {
            "additionalProperties": true,
            "type": "object",
            "title": "Answers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answers"
        ],
        "title": "Submission"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}