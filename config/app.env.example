# Reference only. Use scripts/render_deploy.py to create private production files.
APP_ENV=production
PUBLIC_URL=https://REPLACE_WITH_CONFIRMED_DOMAIN
DATABASE_PATH=/data/lx/campus-start/prod/data/campus.sqlite3
DATA_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
INDEX_HMAC_KEY=REPLACE_WITH_SEPARATE_RANDOM_KEY
EDGE_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_EDGE_TOKEN
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
OPERATOR_NAME=REPLACE_WITH_ACTUAL_ORGANIZER
PRIVACY_CONTACT=REPLACE_WITH_ACTUAL_CONTACT
COHORT=2026
STUDENT_ID_PATTERN=^[0-9]{6,16}$
ROSTER_REQUIRED=false
ENROLLMENT_CODE=
ENABLE_DEMO=false
PHOTO_TASK_ENABLED=false
RETENTION_DAYS=90
DRAFT_RETENTION_DAYS=7
PRIVACY_VERSION=2026-09-v1.1
ICP_NUMBER=
POLICE_NUMBER=
POLICE_URL=

# Safe default across system SQLite versions; WAL requires a fixed runtime.
DATABASE_JOURNAL_MODE=DELETE
